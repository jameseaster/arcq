{
  "name": "@leverstack/arcq",
  "version": "1.1.0",
  "description": "CLI for querying ArcGIS feature services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "npx prettier . --write",
    "test": "mocha",
    "bump": "scripts/bump-version.sh",
    "release:tag": "scripts/release-tag.sh"
  },
  "keywords": [
    "arcgis",
    "cli",
    "gis",
    "esri",
    "feature-service",
    "arcgis-rest-api",
    "agent",
    "ai-agent"
  ],
  "author": "Leverstack LLC (https://leverstack.io)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameseaster/arcq.git"
  },
  "bugs": "https://github.com/jameseaster/arcq/issues",
  "homepage": "https://github.com/jameseaster/arcq#readme",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "arcq": "dist/bin/arcq.js"
  },
  "type": "module",
  "dependencies": {
    "axios": "^1.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^6.2.2",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "mocha": "^11.7.5",
    "prettier": "3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
